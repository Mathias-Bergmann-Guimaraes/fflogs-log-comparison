{
  "name": "fflogs-compare",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "run-p dev:*",
    "dev:web": "vite",
    "dev:admin": "vite --config vite.admin.config.ts",
    "dev:server": "tsx watch --env-file-if-exists=.env --experimental-sqlite server/index.ts",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build && vite build --config vite.admin.config.ts",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "gear-icons": "node --experimental-strip-types scripts/gear-icons.ts && prettier --write src/constants/gearItems.ts",
    "admin": "node --env-file-if-exists=.env --experimental-sqlite --experimental-strip-types scripts/admin.ts",
    "fake-hunt": "node --env-file-if-exists=.env --experimental-strip-types scripts/fake-hunt.ts",
    "codegen":"node --env-file=.env node_modules/@graphql-codegen/cli/cjs/bin.js --config codegen.ts",
    "start": "node --env-file-if-exists=.env --experimental-sqlite --experimental-strip-types server/index.ts"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@hono/node-server": "^2.1.5",
    "ant-design-vue": "^4.2.6",
    "echarts": "^6.0.0",
    "hono": "^4.13.13",
    "pinia": "^3.0.4",
    "vue": "^3.5.31",
    "vue-echarts": "^8.0.1",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.3.1",
    "@graphql-codegen/typescript": "^5.0.10",
    "@graphql-codegen/typescript-operations": "^5.1.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.57.0",
    "eslint-plugin-vue": "~10.8.0",
    "graphql": "^16.13.2",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.57.0",
    "prettier": "3.8.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "vite": "^8.0.3",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
