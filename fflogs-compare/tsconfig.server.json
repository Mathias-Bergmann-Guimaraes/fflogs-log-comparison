// TSConfig for the API server in server/, run with tsx (dev) or Node's type-stripping.
{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["server/**/*", "scripts/**/*", "src/constants/gearSharing.ts", "src/types/hunts.ts", "src/types/admin.ts", "src/types/plugin.ts"],
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo"
  }
}
